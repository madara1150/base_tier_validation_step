<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stepback_wizard_form" model="ir.ui.view">
        <field name="name">tier.validation.step.wizard.form</field>
        <field name="model">tier.validation.step.wizard</field>
        <field name="arch" type="xml">
            <form string="Step Back Validation">
                <field name="res_model" invisible="1" />
                <field name="res_id" invisible="1" />
                <field name="available_review_ids" invisible="1" />
                <group>
                    <field
                        name="selected_review_id"
                        options="{'no_create': True, 'no_open': True}"
                    />
                    <field
                        name="reason"
                        placeholder="Why is this document going back?"
                    />
                </group>
                <group
                    string="These tiers will be reviewed again"
                    attrs="{'invisible': [('selected_review_id', '=', False)]}"
                >
                    <field name="reset_review_ids" nolabel="1" colspan="2">
                        <tree>
                            <field name="sequence" />
                            <field name="name" />
                            <field name="status" />
                            <field name="done_by" />
                        </tree>
                    </field>
                </group>
                <footer>
                    <button
                        string="Confirm"
                        type="object"
                        name="action_confirm_stepback"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
